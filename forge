#!/usr/bin/env bash
set -euo pipefail

FORGE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FORGE_PYTHON="${FORGE_PYTHON:-${FORGE_ROOT}/.venv/bin/python}"
FORGE_RUFF="${FORGE_RUFF:-${FORGE_ROOT}/.venv/bin/ruff}"
FORGE_MYPY="${FORGE_MYPY:-${FORGE_ROOT}/.venv/bin/mypy}"
FORGE_COVERAGE="${FORGE_COVERAGE:-${FORGE_ROOT}/.venv/bin/coverage}"

if [[ ! -x "${FORGE_PYTHON}" ]]; then
  FORGE_PYTHON="python3"
fi

command_name="${1:-}"
case "${command_name}" in
  dev)
    cd "${FORGE_ROOT}"
    "${FORGE_PYTHON}" -m forge_core.demo
    ;;
  dashboard)
    cd "${FORGE_ROOT}"
    "${FORGE_PYTHON}" -m forge_core.dashboard_server
    ;;
  test)
    cd "${FORGE_ROOT}"
    "${FORGE_COVERAGE}" erase
    "${FORGE_COVERAGE}" run -m unittest discover -s tests -v
    "${FORGE_COVERAGE}" report
    ;;
  lint)
    cd "${FORGE_ROOT}"
    "${FORGE_RUFF}" check .
    "${FORGE_RUFF}" format --check .
    ;;
  typecheck)
    cd "${FORGE_ROOT}"
    "${FORGE_MYPY}"
    ;;
  lockcheck)
    cd "${FORGE_ROOT}"
    "${FORGE_PYTHON}" scripts/check_lock.py requirements.lock
    "${FORGE_PYTHON}" -m pip check
    ;;
  verify)
    "${BASH_SOURCE[0]}" lint
    "${BASH_SOURCE[0]}" typecheck
    "${BASH_SOURCE[0]}" lockcheck
    "${BASH_SOURCE[0]}" test
    ;;
  *)
    echo "usage: ./forge {dev|dashboard|test|lint|typecheck|lockcheck|verify}" >&2
    exit 2
    ;;
esac
